{
  "name": "focus-lens-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run licenses && tsc --noEmit && vite build && npm run audit:public",
    "build:parser": "node scripts/build-parser.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "licenses": "node scripts/collect-licenses.mjs",
    "audit:public": "node scripts/audit-public.mjs"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "fflate": "0.8.3",
    "pixi.js": "8.14.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  },
  "license": "MIT"
}
